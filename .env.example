# Life OS environment variables.
# Copy to .env and fill in real values. .env is gitignored.

# --- Notion (used by .notion/setup.py and n8n workflows) ---
NOTION_TOKEN=ntn_your_token_here
PARENT_PAGE_ID=your_parent_page_id_without_dashes

# --- Notion DB IDs (after .notion/setup.py runs, copy from db_ids.json) ---
# Required by n8n workflows that write directly to a specific DB.
NOTION_INBOX_DB_ID=
NOTION_PROJECT_DB_ID=
NOTION_TASK_DB_ID=

# --- Telegram (Phase 1 inbox channel) ---
# Get TELEGRAM_BOT_TOKEN from @BotFather, TELEGRAM_CHAT_ID from
# https://api.telegram.org/bot<TOKEN>/getUpdates after sending the bot a message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
